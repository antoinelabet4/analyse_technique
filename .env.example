# Clé API Anthropic pour le texte explicatif (phases suivantes, non utilisée en P0).
# Jamais commise réellement : ce fichier ne contient que des exemples.
ANTHROPIC_API_KEY=

# Modèle Claude utilisé pour le texte explicatif (phases suivantes).
LLM_MODEL=claude-sonnet-5-5

# Jeton secret que votre n8n doit envoyer dans l'en-tête X-Trigger-Token
# pour déclencher POST /api/daily-trigger. Choisissez une valeur longue
# et aléatoire, jamais celle-ci telle quelle.
N8N_TRIGGER_TOKEN=

# Bot Telegram pour l'envoi du résumé quotidien (jamais commis réellement).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
